/*
 * Example of your own skin. Copy this file to skin.css in the same folder and
 * reload; the skin button then offers a fourth option called "local".
 *
 * Scoped to that skin, so the other three stay as they are. Drop the scope if
 * you want a change everywhere.
 */

body[data-theme="local"] {
  /* the whole app is built on these, so a palette is enough for a new look */
  --bg:#21201c;
  --panel:#32302c;
  --panel2:#3b3934;
  --border:#4b4842;
  --text:#ece8e1;
  --muted:#a29c92;
  --accent:#cf4b33;
  --accent-soft:#3b2a25;
  --active:#d98a2b;
  --active-soft:#3a2f1e;
  --ok:#84b25e;
  --ok-soft:#2b3925;
  --bad:#dc6552;
  --wave-bg:#26241f;
  --wave-grid:#3a3833;
  --wave-axis:#4b4842;
  --radius:6px;
}

